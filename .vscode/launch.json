{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Object_Roguelike (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/vs_build/Object_Roguelike.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Object_Roguelike (x64)",
            "postDebugTask": ""
        }
    ]
}
